{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bleakhold Launcher",
  "version": "1.1.0",
  "identifier": "net.bleakhold.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bleakhold Launcher",
        "width": 1180,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": false,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
