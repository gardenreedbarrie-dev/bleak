# BLEAKHOLD(bleakfx): writes OUTPUT, a header with one byte array per compiled shader in INPUTS (.cso paths
# separated by |), named g_bleakFxShader_<file name without extension>.
string(REPLACE "|" ";" INPUTS "${INPUTS}")

# CMake regular expressions have no {n}: sixteen bytes per line, spelled out.
set(line_pattern "")
foreach (i RANGE 15)
    string(APPEND line_pattern "0x[0-9a-f][0-9a-f], ")
endforeach ()

set(text "// Generated by Engine/Source/BleakFx/EmbedShaders.cmake from the fxc output of Shaders/*.hlsl. Do not edit.\n")
string(APPEND text "#ifndef BLEAKFX_SHADERS_H\n#define BLEAKFX_SHADERS_H\n\n#include <cstdint>\n\n#define BLEAKFX_HAVE_SHADERS 1\n")

foreach (input ${INPUTS})
    get_filename_component(name ${input} NAME_WE)
    file(READ ${input} hex HEX)
    string(LENGTH "${hex}" length)

    # Shader bytecode is a whole number of 32-bit tokens.
    math(EXPR remainder "${length} % 8")
    if (length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "BleakFx: ${input} is not shader bytecode")
    endif ()

    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " bytes "${hex}")
    string(REGEX REPLACE "(${line_pattern})" "\\1\n    " bytes "${bytes}")
    string(REGEX REPLACE " +\n" "\n" bytes "${bytes}")
    string(REGEX REPLACE "[ \n]+$" "" bytes "${bytes}")
    string(APPEND text "\nstatic const uint8_t g_bleakFxShader_${name}[] = {\n    ${bytes}\n};\n")
endforeach ()

string(APPEND text "\n#endif\n")
file(WRITE ${OUTPUT} "${text}")
