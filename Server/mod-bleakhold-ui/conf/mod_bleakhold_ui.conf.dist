#
# mod-bleakhold-ui: server side of the Bleakhold UI (docs/BleakholdProtocol.md in the Bleakhold repository).
# Copy this file to mod_bleakhold_ui.conf next to worldserver.conf (the build installs it into the
# modules config folder) and change what you need. ".bleakhold reload" in game re-reads it.
#

[worldserver]

###################################################################################################
# GENERAL
###################################################################################################
#
#    BleakholdUi.Enable
#        Description: Answer the Bleakhold UI. When disabled the module ignores client messages (it
#                     still blocks the BHs prefix from clients) and sends nothing.
#        Default:     1 - Enabled
#                     0 - Disabled

BleakholdUi.Enable = 1

#
#    BleakholdUi.Debug
#        Description: Log every accepted intent and every dropped message (with the reason) to the
#                     "module" logger. Also: .bleakhold debug on|off
#        Default:     0 - Disabled

BleakholdUi.Debug = 0

#
#    BleakholdUi.RealmName
#        Description: Realm name shown by the UI. Empty = the realm name from the realmlist table.
#        Default:     ""

BleakholdUi.RealmName = ""

#
#    BleakholdUi.SiteUrl
#        Description: Web address shown under the leaderboards (players can copy it).
#        Default:     ""

BleakholdUi.SiteUrl = ""

#
#    BleakholdUi.UtcOffsetMinutes
#        Description: Realm time zone in minutes from UTC (for showing the weekly reset as realm time).
#                     Any value outside -1440..1440 means: use the server computer's time zone.
#        Example:     60 (Central Europe in winter), -300 (US East in winter)
#        Default:     -10000 - automatic

BleakholdUi.UtcOffsetMinutes = -10000

#
#    BleakholdUi.MinProtocol
#        Description: Oldest Bleakhold UI protocol this server still talks to. Older clients show
#                     "out of date" and stop sending. Leave at 1.
#        Default:     1

BleakholdUi.MinProtocol = 1

#
#    BleakholdUi.DataVersion
#        Description: Version of the definitions (names and texts from the bleakhold_* world tables).
#                     0 = computed from the content: clients download the definitions again whenever
#                     a row changes (after .bleakhold reload or a restart).
#        Default:     0 - automatic

BleakholdUi.DataVersion = 0

#
#    BleakholdUi.Season.Id
#        Description: Current season id. 0 = the bleakhold_season row with state 1 (the highest id if several
#                     rows have state 1).
#        Default:     0

BleakholdUi.Season.Id = 0

###################################################################################################
# FEATURES (sent to the client in HELLO; the UI hides what is not live yet)
###################################################################################################
#
#    BleakholdUi.Feature.RiftScoring    1 when your Eclipse Rift sends scores          Default: 0
#    BleakholdUi.Feature.Shards         1 when your Dungeon Journey pays Shards        Default: 0
#    BleakholdUi.Feature.Season         1 to show the season and war effort            Default: 1
#    BleakholdUi.Feature.Leaderboards   1 to show the leaderboards                     Default: 1
#    BleakholdUi.Feature.Collections    1 when your collection system sends COLL/SET   Default: 0
#
#    Bleakhold Royale (feature bit 4096) has no key here: the system that runs it turns the bit on at runtime
#    (Ui::SetFeature; mod-bleakhold does it when Bleakhold.Royale.Enable = 1 and its data checks pass).
#    The battleground kill announcer (feature bit 8192, BGANN) has none either: mod-bleakhold turns it on while
#    Bleakhold.BgAnnouncer.Enable = 1.

BleakholdUi.Feature.RiftScoring = 0
BleakholdUi.Feature.Shards = 0
BleakholdUi.Feature.Season = 1
BleakholdUi.Feature.Leaderboards = 1
BleakholdUi.Feature.Collections = 0

###################################################################################################
# FRAMES
###################################################################################################
#
#    BleakholdUi.Frame.MaxBody
#        Description: Largest frame body sent to the client, in bytes (64..1000). Longer messages are
#                     split into numbered parts. 1000 is the protocol's limit; 251 makes every chat
#                     packet 255 bytes or less (more packets).
#        Default:     1000

BleakholdUi.Frame.MaxBody = 1000

###################################################################################################
# RATE LIMITS (per player; the core does not throttle addon messages)
###################################################################################################
#
#    BleakholdUi.RateLimit.Burst / PerSecond
#        Description: Every Bleakhold message from a client takes a token from a bucket of Burst tokens,
#                     refilled at PerSecond. Messages without a token are dropped silently.
#        Default:     10 / 5
#
#    BleakholdUi.RateLimit.FloodDrops / FloodWindowSec / FloodMuteSec
#        Description: After FloodDrops dropped messages within FloodWindowSec seconds the player's
#                     Bleakhold messages are ignored for FloodMuteSec seconds (and it is logged).
#        Default:     200 / 60 / 60
#
#    BleakholdUi.RateLimit.HelloIntervalMs       HELLO at most once per this many ms        Default: 5000
#    BleakholdUi.RateLimit.GetTopicIntervalMs    each GET topic at most once per this many ms Default: 1000
#    BleakholdUi.RateLimit.HeavyTopicIntervalMs  GET DEF, LIDX, BOARD (large answers) at most once per this
#                                              many ms; a new HELLO (login, /reload) resets it  Default: 5000
#    BleakholdUi.RateLimit.LeaderboardPerSecond  LBQ per second                              Default: 2
#    BleakholdUi.RateLimit.QueueIntervalMs       QJOIN, QLEAVE, QREPLY: one each per ms      Default: 1000
#    BleakholdUi.RateLimit.KeyIntervalMs         KSTART, KCANCEL, KMODE: one each per ms     Default: 2000
#    BleakholdUi.RateLimit.ClaimPerSecond        TCLAIM, TREROLL, BCLAIM, OUTFIT, WEHANDIN together per second
#                                                                                         Default: 2
#    BleakholdUi.RateLimit.DuplicateWindowMs     the same action again within this many ms is ignored
#                                              (0 = off). Your handlers must still be idempotent.
#                                                                                         Default: 1000
#    BleakholdUi.RateLimit.CampIntervalMs        CAMP (make camp, place an object, pack up: together) one per
#                                              this many ms                               Default: 1000
#    BleakholdUi.RateLimit.GlideIntervalMs       GLIDE one per this many ms                 Default: 1000
#    BleakholdUi.RateLimit.RepairIntervalMs      REPAIR one per this many ms                Default: 2000
#    BleakholdUi.RateLimit.RoyaleIntervalMs      Bleakhold Royale RDROP (landing pin) and RSPEC (spectator
#                                              camera): one each per this many ms           Default: 500
#    BleakholdUi.RateLimit.RoyaleDeployIntervalMs  Bleakhold Royale RDEPLOY (open the parachute) one per this
#                                              many ms                                     Default: 1000
#    BleakholdUi.RateLimit.WarModeIntervalMs     WARMODE (turn War Mode on or off, section 19) one per this
#                                              many ms; the server's own toggle cooldown is far longer   Default: 2000
#    BleakholdUi.RateLimit.CafeShiftIntervalMs   the cafe (section 21): CSHIFT and CSTAFF, one each per ms
#                                                                                         Default: 2000
#    BleakholdUi.RateLimit.CafeTakeIntervalMs    CTAKE one per this many ms                 Default: 500
#    BleakholdUi.RateLimit.CafeStepIntervalMs    CSTEP one per this many ms                 Default: 200
#    BleakholdUi.RateLimit.CafeReleaseIntervalMs CREL one per this many ms                  Default: 100
#    BleakholdUi.RateLimit.CafeOrderIntervalMs   CORDER and CCANCEL, one each per ms        Default: 2000

BleakholdUi.RateLimit.Burst = 10
BleakholdUi.RateLimit.PerSecond = 5
BleakholdUi.RateLimit.FloodDrops = 200
BleakholdUi.RateLimit.FloodWindowSec = 60
BleakholdUi.RateLimit.FloodMuteSec = 60
BleakholdUi.RateLimit.HelloIntervalMs = 5000
BleakholdUi.RateLimit.GetTopicIntervalMs = 1000
BleakholdUi.RateLimit.HeavyTopicIntervalMs = 5000
BleakholdUi.RateLimit.LeaderboardPerSecond = 2
BleakholdUi.RateLimit.QueueIntervalMs = 1000
BleakholdUi.RateLimit.KeyIntervalMs = 2000
BleakholdUi.RateLimit.ClaimPerSecond = 2
BleakholdUi.RateLimit.DuplicateWindowMs = 1000
BleakholdUi.RateLimit.CampIntervalMs = 1000
BleakholdUi.RateLimit.GlideIntervalMs = 1000
BleakholdUi.RateLimit.RepairIntervalMs = 2000
BleakholdUi.RateLimit.RoyaleIntervalMs = 500
BleakholdUi.RateLimit.RoyaleDeployIntervalMs = 1000
BleakholdUi.RateLimit.WarModeIntervalMs = 2000
BleakholdUi.RateLimit.CafeShiftIntervalMs = 2000
BleakholdUi.RateLimit.CafeTakeIntervalMs = 500
BleakholdUi.RateLimit.CafeStepIntervalMs = 200
BleakholdUi.RateLimit.CafeReleaseIntervalMs = 100
BleakholdUi.RateLimit.CafeOrderIntervalMs = 2000

###################################################################################################
# EMOJI BUBBLES (EMOJI: an emoji over the player's head for everyone nearby; needs the Bleakhold client)
###################################################################################################
#
#    BleakholdUi.Emoji.Enable
#        Description: Let players show emoji bubbles (feature bit 64). The emoji list is built into
#                     the module (src/BleakholdEmoji.h, made by Tools/EmojiForge).
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Emoji.CooldownMs
#        Description: Time a player must wait between two emojis, in ms (0 = no limit). The addon
#                     waits 3.25 s itself; above 3250 some presses are answered "busy".
#        Default:     2500

BleakholdUi.Emoji.Enable = 1
BleakholdUi.Emoji.CooldownMs = 2500

###################################################################################################
# DANCES (DANCE: a Bleakhold dance until the player moves; the Bleakhold client shows it, stock
# clients see the stock dance)
###################################################################################################
#
#    BleakholdUi.Dance.Enable
#        Description: Let players dance the Bleakhold dances (feature bit 128). The dance list is built
#                     into the module (src/BleakholdDance.h, made by Tools/DanceForge); a dance needs no
#                     DBC or model change on the server.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Dance.CooldownMs
#        Description: Time a player must wait between two dances, in ms (0 = no limit). The addon
#                     waits 1.25 s itself; above 1250 some presses are answered "busy".
#        Default:     1000

BleakholdUi.Dance.Enable = 1
BleakholdUi.Dance.CooldownMs = 1000

###################################################################################################
# CASES (CASEOPEN: open a case item for one of its rewards; the cases are the world tables
# bleakhold_case and bleakhold_case_reward, data/sql/db-world/02_bleakhold_case_tables.sql)
###################################################################################################
#
#    BleakholdUi.Case.Enable
#        Description: Let players open cases (feature bit 256 when at least one case is set up).
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Case.CooldownMs
#        Description: Time a player must wait between two cases, in ms (0 = no limit). The addon waits
#                     for each answer, and its reel takes about 6 s unless the player skips it.
#        Default:     1000

BleakholdUi.Case.Enable = 1
BleakholdUi.Case.CooldownMs = 1000

###################################################################################################
# CAMPING (protocol section 16: CAMP, GLIDE, REPAIR, CAMPST)
#
# A player makes camp (a campfire for Camp.FireDuration), rests at any lit fire within Camp.Radius (rested XP
# accrues like at an inn, and a logout there is an inn logout), settles after Camp.SettleTime and then gets the
# buff of every camp object at that fire and Campfire Warmth (+Camp.WarmthXpPct % kill and quest XP for
# Camp.WarmthDuration). Players with a profession place one camp object at a fire (three per fire); Well Fed
# food gives +Camp.FoodXpPct % XP anywhere. Times are in seconds. The spell ids below come from camping-assets
# research without the client's Spell.dbc: check the buffs in game and change them here if needed.
###################################################################################################
#
#    BleakholdUi.Camp.Enable
#        Description: Camping: CAMP, camp rest, warmth, the food XP bonus and repair at a camp anvil (feature
#                     bit 512). With 0, fires stop counting, CAMP answers camp_off and the XP bonus is off.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Camp.MinLevel
#        Description: The level a player needs to make camp.
#        Default:     5
#
#    BleakholdUi.Camp.Cooldown
#        Description: Seconds between two CAMP M of one player (a relog does not reset it).
#        Default:     900
#
#    BleakholdUi.Camp.FireDuration
#        Description: Seconds a camp fire burns (10..86400). Camp objects last as long as their fire.
#        Default:     900
#
#    BleakholdUi.Camp.FireEntry
#        Description: gameobject_template entry of the camp fire: a generic object or a spell focus with no
#                     script, no linked trap and a focus in BleakholdUi.Camp.AllowedFocusIds (else the Basic
#                     Campfire, 29784, is used). 194300 "Toasty Fire" is a WotLK bonfire that also works as a
#                     cooking fire (focus 4).
#        Default:     194300
#
#    BleakholdUi.Camp.ExtraFireEntries
#        Description: More gameobject entries that count as campfires (at most 15, any separator), world
#                     spawns included. Basic Campfires (29784) players light always count; its world spawns
#                     do not. Fires only count on the continents.
#        Example:     "3797 3798 3799" (Cozy Fire in towns)
#        Default:     ""
#
#    BleakholdUi.Camp.Radius
#        Description: Yards from a fire within which a player rests there (2..30).
#        Default:     10
#
#    BleakholdUi.Camp.SettleTime
#        Description: Seconds at a fire (out of combat) before the player settles: camp object buffs and
#                     Campfire Warmth. Combat or leaving starts it over.
#        Default:     60
#
#    BleakholdUi.Camp.BuffDuration
#        Description: Seconds a camp object buff lasts (passive or permanent auras keep their own).
#        Default:     3600
#
#    BleakholdUi.Camp.WarmthDuration
#        Description: Seconds of Campfire Warmth after settling (settling again starts it over, never adds up).
#        Default:     1800
#
#    BleakholdUi.Camp.WarmthXpPct
#        Description: Extra kill and quest XP in percent while Campfire Warmth lasts.
#        Default:     10
#
#    BleakholdUi.Camp.WarmthSpell
#        Description: An aura the player also gets for the warmth, only to show it (the XP bonus is the
#                     module's own). Never use an aura with an XP effect (Ribbon Dance, 29175): the core would
#                     add its bonus on top. 7353 (Cozy Fire) is the Basic Campfire's own small buff.
#        Default:     0 - none
#
#    BleakholdUi.Camp.FoodXpPct
#        Description: Extra kill and quest XP in percent while the player has a Well Fed buff (spell group
#                     1001), anywhere.
#        Default:     5
#
#    BleakholdUi.Camp.MaxXpPct
#        Description: The warmth and food bonus together never exceed this (applied once, after other modules'
#                     XP multipliers; nothing at the level cap).
#        Default:     25
#
#    BleakholdUi.Camp.TierSkill
#        Description: Profession skill for camp object tiers 1, 2 and 3 (three increasing values). A player
#                     places the highest tier they reach.
#        Default:     "75,225,375"
#
#    BleakholdUi.Camp.Profession.<Name>
#        Description: The camp objects of a profession: six ids, the gameobject entries of tiers 1, 2 and 3,
#                     then the buff spell of tiers 1, 2 and 3 (0 = none). "0" alone: no camp objects for that
#                     profession. Objects must be generic objects or spell foci with no script and no trap
#                     (a spell focus only with a focus of BleakholdUi.Camp.AllowedFocusIds); buffs should be
#                     self auras (a party aura would reach players who never settled). Ids that do not exist
#                     or break these rules are logged at startup and left out. A Blacksmithing object of tier
#                     2 or 3 is a camp anvil (REPAIR).
#
#    BleakholdUi.Camp.AllowedFocusIds
#        Description: The spell foci (SpellFocusObject.dbc ids, any separator) a camp object or the camp fire
#                     may be, so recipes that need that station work at a camp: the common ones found in
#                     every town or lit by anyone. A game object with any other focus is a crafting station
#                     tied to a place (Alchemy Lab 663, Mana Loom 1426, moonwells, the Death Knight runeforge)
#                     and is refused at startup. Keep 4 for a camp fire that is a cooking fire.
#        Default:     "1,3,4" - anvil, forge, cooking fire
#
#    BleakholdUi.Repair.Enable
#        Description: Blacksmiths repair anywhere with REPAIR (feature bit 2048). REPAIR at a camp anvil only
#                     needs BleakholdUi.Camp.Enable.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Repair.MinSkill
#        Description: Blacksmithing skill a player needs to repair anywhere.
#        Default:     75
#
#    BleakholdUi.Repair.BlacksmithDiscountPct
#        Description: Blacksmiths pay this much less for any REPAIR (the normal repair cost otherwise, with
#                     Rate.RepairCost; never part of a repair: all or nothing).
#        Default:     10
#
#    BleakholdUi.Glide.Enable
#        Description: GLIDE, Walk on Air, for the races in BleakholdUi.Glide.Races (feature bit 1024): a fall
#                     becomes a glide the player steers by turning. It slows the fall and pushes the player
#                     forward along their facing (again whenever they turn); it never lifts them. Landing or
#                     water ends it; a GLIDE on the ground waits for a ledge until the aura runs out. No
#                     glide in battlegrounds, arenas and Bleakhold Royale, in dungeons and raids (unless
#                     BleakholdUi.Glide.Instances), mounted, on a vehicle or flight path, flying, in water,
#                     rooted, stunned or not in control.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Glide.Races
#        Description: Race ids that can glide (any separator): the High Elf's race id on this realm, the same
#                     as Bleakhold.Racials.HighElfRace of mod-bleakhold. 15 on the Bleakhold realm, whose own
#                     race patch put the High Elf in that stock slot (Tools/RaceForge/races.json, realm_id);
#                     22 on a realm built with RaceForge's build.
#        Default:     "15"
#
#    BleakholdUi.Glide.Cooldown
#        Description: Seconds between two glides of one player (a relog does not reset it), by GLIDE or by
#                     the spellbook racial (BleakholdUi.Glide.CastSpell), whose button shows it.
#        Default:     90
#
#    BleakholdUi.Glide.Duration
#        Description: Seconds the glide aura lasts (1..600), from GLIDE on (a wait for a ledge counts). The
#                     glide bar follows it; Walk on Air's buff tooltip says the duration of its Spell.dbc row
#                     (10 s, DurationIndex 1 in the client row and in 02_bleakhold_walk_on_air.sql): change
#                     them together.
#        Default:     10
#
#    BleakholdUi.Glide.Spell
#        Description: The glide's aura, cast triggered (no reagent, no cooldown): a spell with a feather fall
#                     aura (SPELL_AURA_FEATHER_FALL) on the caster only. 100800 is Walk on Air, the module's
#                     own spell: its server row is data/sql/db-world/02_bleakhold_walk_on_air.sql, and the
#                     client needs the same row in its Spell.dbc (patch MPQ) for the buff's name, icon and
#                     look (its visual). A spell the server lacks or that has no feather fall falls back to 130 (Slow
#                     Fall). The aura ends with the glide (landing, water, its duration), except a Slow Fall
#                     the player cast again (a mage's own).
#        Default:     100800 - Walk on Air
#                     130    - Slow Fall
#
#    BleakholdUi.Glide.ForwardSpeed
#        Description: Yards per second the glide carries the player forward (0..30; their run speed is 7).
#                     0: no push at all, the aura alone (a slow fall the player cannot steer).
#        Default:     12
#
#    BleakholdUi.Glide.Steer
#        Description: Push again whenever the gliding player turns (5 degrees or more, at most five times a
#                     second, not within 2.5 yd of the ground), so the glide follows their facing. The 3.3.5a
#                     client keeps a fall's direction by itself. 0: one push when the glide starts, straight
#                     ahead.
#        Default:     1 - Enabled
#                     0 - Disabled
#
#    BleakholdUi.Glide.RequireFalling
#        Description: GLIDE only in the air (falling or jumping; else ERR glide_ground). With 0 a GLIDE on the
#                     ground waits for a ledge.
#        Default:     0 - Disabled
#                     1 - Enabled
#
#    BleakholdUi.Glide.Instances
#        Description: GLIDE in dungeons and raids. Off, its steerable forward push cannot skip a dungeon's
#                     jump shortcuts (Mythic+ routes and timers) or undo a boss's drop-off mechanics
#                     (knockbacks off a platform, the Lich King's edge): GLIDE there is ERR glide_here, and a
#                     glide taken in (a teleport, a summon, an instance portal) ends on arrival with its aura.
#                     Slow Fall, with no forward push, never had this problem. Battlegrounds, arenas and
#                     Bleakhold Royale never allow the glide.
#        Default:     0 - Disabled
#                     1 - Enabled
#
#    BleakholdUi.Glide.StartVisualKit
#        Description: SpellVisualKit.dbc id shown on the player (with its sound) when a fall becomes a glide.
#                     13709 is Wind Shear's gust of wind and whoosh. 0: none. The rest of the glide's look is
#                     the spell visual of BleakholdUi.Glide.Spell's Spell.dbc row: Walk on Air (100800) has 63,
#                     Slow Fall's (a light at the hands and a soft flash at the head when the glide starts,
#                     nothing that stays on the character). Other stock visuals that fit: 0 (none), 12114
#                     (Guardian Spirit's golden wings for the whole glide), 12724 (Cyclone Fall's whirl and a
#                     floating pose), 6768 (Levitate's swirl at the feet), 7370 (Magic Wings, wings at the
#                     head: the old look). Change it in Tools/RaceForge/races.json (the client's row) and in
#                     data/sql/db-world/02_bleakhold_walk_on_air.sql together, then raceforge.py update.
#        Default:     13709
#
#    BleakholdUi.Glide.CastSpell
#        Description: Walk on Air in the spellbook: the racial the module teaches at login to the races of
#                     BleakholdUi.Glide.Races (and takes from every other character), put once on the first
#                     empty slot of the main action bar (or of the bottom and right bars). Casting it starts
#                     the glide with the rules of GLIDE, in the air only (falling or jumping: on the ground the
#                     cast fails with the client's "Cannot be used on the ground" and costs nothing), and shares
#                     the cooldown with GLIDE (/glide, the key binding, the Glide button), which its button
#                     shows (the spell row's own is 90 s; another BleakholdUi.Glide.Cooldown is sent to the
#                     client). 100801 is the module's row (data/sql/db-world/02_bleakhold_walk_on_air.sql, with
#                     its spell_bleakhold_walk_on_air script); the client needs the same row in its Spell.dbc
#                     (Tools/RaceForge/races.json, raceforge.py update) to show it. A spell the server lacks, or
#                     without that script, leaves the spellbook without it (logged). 0: none.
#        Default:     100801 - Walk on Air
#                     0      - no spellbook spell (GLIDE only)

BleakholdUi.Camp.Enable = 1
BleakholdUi.Camp.MinLevel = 5
BleakholdUi.Camp.Cooldown = 900
BleakholdUi.Camp.FireDuration = 900
BleakholdUi.Camp.FireEntry = 194300
BleakholdUi.Camp.ExtraFireEntries = ""
BleakholdUi.Camp.Radius = 10
BleakholdUi.Camp.SettleTime = 60
BleakholdUi.Camp.BuffDuration = 3600
BleakholdUi.Camp.WarmthDuration = 1800
BleakholdUi.Camp.WarmthXpPct = 10
BleakholdUi.Camp.WarmthSpell = 0
BleakholdUi.Camp.FoodXpPct = 5
BleakholdUi.Camp.MaxXpPct = 25
BleakholdUi.Camp.TierSkill = "75,225,375"
BleakholdUi.Camp.AllowedFocusIds = "1,3,4"
BleakholdUi.Camp.Profession.Alchemy = "190678,190444,190689,8113,12177,23738"
BleakholdUi.Camp.Profession.Blacksmithing = "201893,189626,171715,8094,12175,23767"
BleakholdUi.Camp.Profession.Enchanting = "186746,181361,184723,8097,12176,23766"
BleakholdUi.Camp.Profession.Engineering = "193585,193668,184624,8116,12174,23736"
BleakholdUi.Camp.Profession.Herbalism = "195194,180801,180805,8113,12177,15366"
BleakholdUi.Camp.Profession.Inscription = "187254,191140,190693,8097,12176,23768"
BleakholdUi.Camp.Profession.Jewelcrafting = "188190,184909,188048,8119,12179,23735"
BleakholdUi.Camp.Profession.Leatherworking = "188221,176461,188223,8100,12178,23737"
BleakholdUi.Camp.Profession.Mining = "190386,180780,123207,8100,12178,23737"
BleakholdUi.Camp.Profession.Skinning = "19875,180692,187983,8116,12174,22817"
BleakholdUi.Camp.Profession.Tailoring = "181077,200297,188216,8100,12178,22818"
BleakholdUi.Camp.Profession.Cooking = "181790,3769,186143,24870,57288,57399"
BleakholdUi.Camp.Profession.FirstAid = "181129,180676,178226,8094,12175,23769"
BleakholdUi.Camp.Profession.Fishing = "186614,181143,190226,7840,12177,22820"
BleakholdUi.Repair.Enable = 1
BleakholdUi.Repair.MinSkill = 75
BleakholdUi.Repair.BlacksmithDiscountPct = 10
BleakholdUi.Glide.Enable = 1
BleakholdUi.Glide.Races = "15"
BleakholdUi.Glide.Cooldown = 90
BleakholdUi.Glide.Duration = 10
BleakholdUi.Glide.Spell = 100800
BleakholdUi.Glide.ForwardSpeed = 12
BleakholdUi.Glide.Steer = 1
BleakholdUi.Glide.RequireFalling = 0
BleakholdUi.Glide.Instances = 0
BleakholdUi.Glide.StartVisualKit = 13709
BleakholdUi.Glide.CastSpell = 100801

###################################################################################################
# BLEAKHOLD CAFE (protocol section 21: CSHIFT, CTAKE, CSTEP, CREL, CORDER, CCANCEL, CSTAFF and the CAF* topics)
#
# Two cafes, The Lion's Roast in Stormwind (sw) and The Grinding Tusk in Orgrimmar (org): players work shifts
# behind the bar and make coffee, tea and milkshakes for NPC customers and for other players, who order and pay
# for them. A GM places each cafe once with ".cafe build sw" (see .cafe in the commands); the furniture stays
# where it is and is spawned at every start, whatever Cafe.Enable says. The tables come from
# data/sql/db-world/03_bleakhold_cafe_tables.sql, data/sql/db-characters/01_bleakhold_cafe_characters.sql and
# the templates of data/sql/db-world/04_bleakhold_cafe_templates.sql (made by Tools/CafeForge).
# Times are in seconds unless the key says Ms or Min; distances in yards; money in copper.
###################################################################################################
#
#    BleakholdUi.Cafe.Enable
#        Description: The cafe (feature bit 131072). 0 ends every shift without penalty, refunds every order
#                     that was paid and not served, and sends the customers home; the furniture stays.
#                     0 -> 1 by .bleakhold reload works: the startup checks always run.
#        Default:     0 - Disabled
#                     1 - Enabled
#
#    BleakholdUi.Cafe.GmOnly
#        Description: 1 = only game masters get the feature bit, work shifts and order, NPC customers only
#                     come while a game master is near, and only they read the [Cafe] announcements (testing on
#                     the live realm before the launch).
#        Default:     1
#
#    BleakholdUi.Cafe.UseNewArt
#        Description: 1 = the cafe's own models (needs the Bleakhold client patch on every player and the
#                     display rows on the server); 0 = stock stand-in models.
#        Default:     0
#
#    BleakholdUi.Cafe.MinLevel           level needed for a shift (1..80)                     Default: 10
#    BleakholdUi.Cafe.ShiftRadius        yards from the cafe within which a shift lasts (10..60)  Default: 30
#    BleakholdUi.Cafe.LeaveWarnSec       seconds outside ShiftRadius before the shift ends    Default: 10
#    BleakholdUi.Cafe.StationRadius      yards from a station's spot to work at it (0.8..3)   Default: 1.5
#    BleakholdUi.Cafe.StationLeaveRadius yards at which a running step at a station breaks (at least
#                                        StationRadius, up to 6)                             Default: 2
#    BleakholdUi.Cafe.StationArcDeg      degrees of the facing arc toward a station (30..360) Default: 120
#    BleakholdUi.Cafe.TickMs             the cafe's tick in ms (100..1000)                    Default: 250
#    BleakholdUi.Cafe.StateGapMs         the least ms between two CAFST of one player (100..2000) Default: 250
#    BleakholdUi.Cafe.IdleTicketSec      a shift that holds a ticket ends after this many seconds without an
#                                        action (its tickets go back to the queue)           Default: 120
#    BleakholdUi.Cafe.IdleSec            a shift without a step for this long ends            Default: 300
#    BleakholdUi.Cafe.MaxBaristasPerIp   shifts at once from one IP address (1..10)           Default: 2
#    BleakholdUi.Cafe.MaxBaristas        baristas behind one bar (1..8)                       Default: 4
#    BleakholdUi.Cafe.WarnSec            seconds mounted, shapeshifted, stealthed or invisible before the
#                                        shift ends (1..30)                                   Default: 5
#    BleakholdUi.Cafe.LatencyCompMaxMs   the most a CREL client time may be behind the server's (100..1000)
#                                                                                         Default: 400
#    BleakholdUi.Cafe.ReleaseSlackMs     added to the session latency for that bound (0..400) Default: 150
#    BleakholdUi.Cafe.GoodPadPermille    the Good band around the Perfect window (0..300)    Default: 100
#    BleakholdUi.Cafe.GoldShiftPermille  the most the Perfect window moves per ticket (0..150) Default: 50
#
#    BleakholdUi.Cafe.Customer.Enable            NPC customers                              Default: 1
#    BleakholdUi.Cafe.Customer.IntervalSec       seconds between two arrivals (5..600)      Default: 30
#    BleakholdUi.Cafe.Customer.JitterSec         random part of that (0..300)               Default: 8
#    BleakholdUi.Cafe.Customer.BaristaFactorPct  each barista after the first (up to four) makes customers
#                                                come this much faster, percent (100..400)  Default: 160
#    BleakholdUi.Cafe.Customer.MaxAlive          customers at once (0..12)                  Default: 6
#    BleakholdUi.Cafe.Customer.RushMaxAlive      customers at once in the Morning Rush (0..16) Default: 8
#    BleakholdUi.Cafe.Customer.AmbientMax        customers at once while nobody is on shift; they order
#                                                from the owner (0..8)                      Default: 2
#    BleakholdUi.Cafe.Customer.QueueCap          customers in the queue (1..8)              Default: 6
#    BleakholdUi.Cafe.Customer.RushQueueCap      customers in the queue in the Rush (1..8)  Default: 8
#    BleakholdUi.Cafe.Customer.NearPlayerRadius  customers only come while a player is this near (10..200)
#                                                                                         Default: 60
#    BleakholdUi.Cafe.Customer.QueuePatienceSec  a customer waits this long to be served   Default: 60
#    BleakholdUi.Cafe.Customer.DrinkPatienceSec  and this long for the drink, plus PerLineSec per recipe
#                                                line                                      Default: 30
#    BleakholdUi.Cafe.Customer.PerLineSec                                                  Default: 6
#    BleakholdUi.Cafe.Customer.SitMinSec / SitMaxSec  seconds a served customer sits      Default: 40 / 70
#    BleakholdUi.Cafe.Customer.DrinkSpell        a spell a seated customer casts on itself while drinking
#                                                (431 is a drink visual); 0 = the eat emote  Default: 0
#    BleakholdUi.Cafe.Customer.NamedCooldownSec  seconds before the same named regular comes back Default: 600
#
#    BleakholdUi.Cafe.Order.Enable               player orders (CORDER)                     Default: 1
#    BleakholdUi.Cafe.Order.MaxPerDay            orders of one player per day               Default: 12
#    BleakholdUi.Cafe.Order.OrderRadius          yards from the cafe to order               Default: 40
#    BleakholdUi.Cafe.Order.TakeTimeoutSec       a waiting order nobody takes goes to the house after this
#                                                                                         Default: 25
#    BleakholdUi.Cafe.Order.MaxPendingPerCafe    open orders per cafe (1..20)               Default: 6
#    BleakholdUi.Cafe.Order.MaxRuins             ruined tickets of an order before the house takes it over
#                                                (1..5)                                     Default: 2
#    BleakholdUi.Cafe.Order.HouseWorkers         staff who make house orders (1..2)         Default: 2
#    BleakholdUi.Cafe.Order.HouseBaseSec / HousePerLineSec  how long the house takes      Default: 30 / 5
#    BleakholdUi.Cafe.Order.PickupRadius         yards from the counter to pick a drink up (seated at a cafe
#                                                table, the errand boy brings it instead)   Default: 15
#    BleakholdUi.Cafe.Order.PickupSec            a ready drink waits this long; then the price comes back by
#                                                mail (the barista keeps the wage)          Default: 180
#    BleakholdUi.Cafe.Order.BaristaSharePct      the barista's share of the price (0..100); an order keeps the
#                                                share it was paid at                       Default: 60
#    BleakholdUi.Cafe.Order.PairBoostPerDay      orders per day between the same two players that still count
#                                                in full                                   Default: 3
#    BleakholdUi.Cafe.Price.MinCopper            the lowest price of a drink                Default: 200
#    BleakholdUi.Cafe.Price.LevelFloorPct        prices scale with the customer's level (level / 80), but never
#                                                below this percent of the level 80 price    Default: 10
#
#    BleakholdUi.Cafe.Xp.DailyFull / DailyHalf   barista XP per day in full, then at half; after both, none
#                                                                                         Default: 450 / 450
#    BleakholdUi.Cafe.Tip.DailyBaseCopper / DailyPerLevelCopper  NPC tips per day: base plus per
#                                                character level                           Default: 5000 / 2500
#    BleakholdUi.Cafe.Points.DailyCap / RushExtra  weekly board points per day, and RushExtra more on a Rush
#                                                day                                       Default: 400 / 100
#    BleakholdUi.Cafe.Tired.AfterMin / RestMin / Pct  after AfterMin minutes of shifts a barista is Tired
#                                                (rewards at Pct percent) until RestMin minutes off shift
#                                                                                         Default: 60 / 15 / 50
#
#    BleakholdUi.Cafe.Buff.CoffeeXpPct           extra kill and quest XP with a coffee buff; counts as Well Fed
#                                                (the better of the two, within BleakholdUi.Camp.MaxXpPct)
#                                                0 = coffee gives no XP                     Default: 5
#    BleakholdUi.Cafe.Buff.TeaRepPct             extra kill and quest reputation with a tea buff Default: 5
#    BleakholdUi.Cafe.Buff.TeaExcludeFactions    factions tea never adds to (PvP factions; add any War Mode
#                                                faction)                    Default: "509,510,729,730,889,890"
#    BleakholdUi.Cafe.Buff.MaxMin                the most minutes a drink buff adds up to (10..600) Default: 60
#    Coffee and tea never work on a battleground or arena map or in a battlefield zone (Wintergrasp).
#
#    BleakholdUi.Cafe.Rush.Enable                the Morning Rush (0: no new one; a running one still ends)
#                                                                                         Default: 1
#    BleakholdUi.Cafe.Rush.Times                 start times, realm local time, a comma list of HH:MM
#                                                                                         Default: "08:00"
#    BleakholdUi.Cafe.Rush.Minutes / WarnMinutes  its length, and the warning before it   Default: 20 / 5
#    BleakholdUi.Cafe.Rush.Goal                  drinks the whole bar serves for the Rush reward Default: 60
#    BleakholdUi.Cafe.Rush.SurvivorMin / SurvivorXp  drinks a barista serves during a Rush that meets its
#                                                Goal for the Rush Survivor XP (and that XP) Default: 5 / 50
#
#    BleakholdUi.Cafe.Weekly.Enable              the weekly board and its payout            Default: 1
#    BleakholdUi.Cafe.Weekly.MinDrinks / MinDays  drinks and days a barista needs to rank  Default: 50 / 3
#    BleakholdUi.Cafe.Weekly.RewardCopper        the payout of places 1, 2, 3, ... by mail
#                                    Default: "500000,300000,200000,50000,50000,50000,50000,50000,50000,50000"
#    BleakholdUi.Cafe.Title.BaristaId / LegendId / LegendWins  CharTitles ids of the barista titles (0 = no
#                                                title) and the weekly wins for the second  Default: 190 / 191 / 3
#    BleakholdUi.Cafe.DailyResetHour / WeeklyResetWeekday  only when the realm gives no reset time: the hour
#                                                (0..23) and weekday (0 = Sunday)           Default: 6 / 3
#
#    BleakholdUi.Cafe.Close.HostileNearRadius / HostileRadius / HostileDz  a PvP-flagged player of the other
#                                                faction within HostileNearRadius (or in combat within
#                                                HostileRadius), at most HostileDz above or below, in sight,
#                                                pauses the cafe                             Default: 15 / 40 / 5
#    BleakholdUi.Cafe.Close.ConfirmSec / ResumeSec / PauseMaxSec / ReopenSec  seconds before the pause, before
#                                                the cafe resumes, the longest pause before it closes, and the
#                                                time it stays closed                       Default: 5 / 20 / 90 / 120
#
#    BleakholdUi.Cafe.Bot.MinDrinks / PerfectPermille / SdMs  a barista with at least MinDrinks drinks in a
#                                                day, at least PerfectPermille of them Perfect and a release
#                                                spread under SdMs ms, is noted for .cafe flags at the end of
#                                                the shift (nothing else happens)
#                                                                                         Default: 200 / 980 / 30
#    BleakholdUi.Cafe.OverheadKits               spell visuals over the stations (later)    Default: 0

BleakholdUi.Cafe.Enable = 0
BleakholdUi.Cafe.GmOnly = 1
BleakholdUi.Cafe.UseNewArt = 0
BleakholdUi.Cafe.MinLevel = 10
BleakholdUi.Cafe.ShiftRadius = 30
BleakholdUi.Cafe.LeaveWarnSec = 10
BleakholdUi.Cafe.StationRadius = 1.5
BleakholdUi.Cafe.StationLeaveRadius = 2.0
BleakholdUi.Cafe.StationArcDeg = 120
BleakholdUi.Cafe.TickMs = 250
BleakholdUi.Cafe.StateGapMs = 250
BleakholdUi.Cafe.IdleTicketSec = 120
BleakholdUi.Cafe.IdleSec = 300
BleakholdUi.Cafe.MaxBaristasPerIp = 2
BleakholdUi.Cafe.MaxBaristas = 4
BleakholdUi.Cafe.WarnSec = 5
BleakholdUi.Cafe.LatencyCompMaxMs = 400
BleakholdUi.Cafe.ReleaseSlackMs = 150
BleakholdUi.Cafe.GoodPadPermille = 100
BleakholdUi.Cafe.GoldShiftPermille = 50
BleakholdUi.Cafe.Customer.Enable = 1
BleakholdUi.Cafe.Customer.IntervalSec = 30
BleakholdUi.Cafe.Customer.JitterSec = 8
BleakholdUi.Cafe.Customer.BaristaFactorPct = 160
BleakholdUi.Cafe.Customer.MaxAlive = 6
BleakholdUi.Cafe.Customer.RushMaxAlive = 8
BleakholdUi.Cafe.Customer.AmbientMax = 2
BleakholdUi.Cafe.Customer.QueueCap = 6
BleakholdUi.Cafe.Customer.RushQueueCap = 8
BleakholdUi.Cafe.Customer.NearPlayerRadius = 60
BleakholdUi.Cafe.Customer.QueuePatienceSec = 60
BleakholdUi.Cafe.Customer.DrinkPatienceSec = 30
BleakholdUi.Cafe.Customer.PerLineSec = 6
BleakholdUi.Cafe.Customer.SitMinSec = 40
BleakholdUi.Cafe.Customer.SitMaxSec = 70
BleakholdUi.Cafe.Customer.DrinkSpell = 0
BleakholdUi.Cafe.Customer.NamedCooldownSec = 600
BleakholdUi.Cafe.Order.Enable = 1
BleakholdUi.Cafe.Order.MaxPerDay = 12
BleakholdUi.Cafe.Order.OrderRadius = 40
BleakholdUi.Cafe.Order.TakeTimeoutSec = 25
BleakholdUi.Cafe.Order.MaxPendingPerCafe = 6
BleakholdUi.Cafe.Order.MaxRuins = 2
BleakholdUi.Cafe.Order.HouseWorkers = 2
BleakholdUi.Cafe.Order.HouseBaseSec = 30
BleakholdUi.Cafe.Order.HousePerLineSec = 5
BleakholdUi.Cafe.Order.PickupRadius = 15
