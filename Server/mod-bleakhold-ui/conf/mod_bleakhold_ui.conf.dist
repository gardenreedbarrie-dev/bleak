BleakholdUi.Cafe.Order.BaristaSharePct = 60
BleakholdUi.Cafe.Order.PairBoostPerDay = 3
BleakholdUi.Cafe.Price.MinCopper = 200
BleakholdUi.Cafe.Price.LevelFloorPct = 10
BleakholdUi.Cafe.Xp.DailyFull = 450
BleakholdUi.Cafe.Xp.DailyHalf = 450
BleakholdUi.Cafe.Tip.DailyBaseCopper = 5000
BleakholdUi.Cafe.Tip.DailyPerLevelCopper = 2500
BleakholdUi.Cafe.Points.DailyCap = 400
BleakholdUi.Cafe.Points.RushExtra = 100
BleakholdUi.Cafe.Tired.AfterMin = 60
BleakholdUi.Cafe.Tired.RestMin = 15
BleakholdUi.Cafe.Tired.Pct = 50
BleakholdUi.Cafe.Buff.CoffeeXpPct = 5
BleakholdUi.Cafe.Buff.TeaRepPct = 5
BleakholdUi.Cafe.Buff.TeaExcludeFactions = "509,510,729,730,889,890"
BleakholdUi.Cafe.Buff.MaxMin = 60
BleakholdUi.Cafe.Rush.Enable = 1
BleakholdUi.Cafe.Rush.Times = "08:00"
BleakholdUi.Cafe.Rush.Minutes = 20
BleakholdUi.Cafe.Rush.WarnMinutes = 5
BleakholdUi.Cafe.Rush.Goal = 60
BleakholdUi.Cafe.Rush.SurvivorMin = 5
BleakholdUi.Cafe.Rush.SurvivorXp = 50
BleakholdUi.Cafe.Weekly.Enable = 1
BleakholdUi.Cafe.Weekly.MinDrinks = 50
BleakholdUi.Cafe.Weekly.MinDays = 3
BleakholdUi.Cafe.Weekly.RewardCopper = "500000,300000,200000,50000,50000,50000,50000,50000,50000,50000"
BleakholdUi.Cafe.Title.BaristaId = 190
